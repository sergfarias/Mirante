@model IList<Works.DeveloperEvaluation.WebApi.Features.Tarefas.RelatorioTarefa.RelatorioTarefaResponse>

@{
    ViewData["Title"] = "Relatório de Tarefas";
}

<h1>Tarefas</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Status</label>
                <select name="Status" id="status" class="select2 autor form-control" data-allow-clear="true">
                    <option value="-1">Selecione</option>
                    <option value="0">Pendente</option>
                    <option value="1">Em andamento</option>
                    <option value="2">Concluída</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label name="lblInicio" id="lblInicio" class="control-label">Data Inicio</label>
                <input name="DtInicio" id="DtInicio" class="form-control" type="date" />
            </div>

            <div class="form-group mb-3">
                <label name="lblFim" id="lblFim" class="control-label">Data Fim</label>
                <input name="DtFim" id="DtFim" class="form-control" type="date" />
            </div>

            <div class="form-group">
                <input type="submit" value="Buscar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>







<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Descrição</th>
            <th>Status</th>
            <th>Data Vencimento</th>
          </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.Titulo</td>
                <td>@item.Descricao</td>
                 <td>@item.Status</td>
                <td>@item.DataVencimento</td>
           </tr>
        }
    </tbody>
</table>

